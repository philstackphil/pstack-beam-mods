<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>

  <library_effects>
    <effect id="CrateMaterial-effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <diffuse><color>1.0 0.5 0.0 1.0</color></diffuse>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>

  <library_materials>
    <material id="CrateMaterial" name="CrateMaterial">
      <instance_effect url="#CrateMaterial-effect"/>
    </material>
  </library_materials>

  <library_geometries>
    <geometry id="CrateBox" name="CrateBox">
      <mesh>

        <!-- 8 corner positions matching the JBeam node layout:
             bottom face z=0, top face z=1, ±0.5 in x and y -->
        <source id="pos">
          <float_array id="pos-array" count="24">
            -0.5 -0.5  0.0
             0.5 -0.5  0.0
             0.5  0.5  0.0
            -0.5  0.5  0.0
            -0.5 -0.5  1.0
             0.5 -0.5  1.0
             0.5  0.5  1.0
            -0.5  0.5  1.0
          </float_array>
          <technique_common>
            <accessor source="#pos-array" count="8" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>

        <!-- one outward normal per face -->
        <source id="nrm">
          <float_array id="nrm-array" count="18">
             0  0 -1
             0  0  1
             0 -1  0
             0  1  0
            -1  0  0
             1  0  0
          </float_array>
          <technique_common>
            <accessor source="#nrm-array" count="6" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>

        <vertices id="verts">
          <input semantic="POSITION" source="#pos"/>
        </vertices>

        <!-- 12 triangles (2 per face), interleaved pos-idx / nrm-idx pairs -->
        <triangles material="CrateMaterial" count="12">
          <input semantic="VERTEX" source="#verts" offset="0"/>
          <input semantic="NORMAL" source="#nrm"   offset="1"/>
          <p>
            0 0  3 0  2 0    0 0  2 0  1 0
            4 1  5 1  6 1    4 1  6 1  7 1
            0 2  1 2  5 2    0 2  5 2  4 2
            2 3  3 3  7 3    2 3  7 3  6 3
            0 4  4 4  7 4    0 4  7 4  3 4
            1 5  2 5  6 5    1 5  6 5  5 5
          </p>
        </triangles>

      </mesh>
    </geometry>
  </library_geometries>

  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="CrateBox" name="CrateBox" type="NODE">
        <instance_geometry url="#CrateBox">
          <bind_material>
            <technique_common>
              <instance_material symbol="CrateMaterial" target="#CrateMaterial"/>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>

  <scene>
    <instance_visual_scene url="#Scene"/>
  </scene>
</COLLADA>
